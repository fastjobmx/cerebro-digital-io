# ── Cliente (Vite: sólo las variables VITE_* llegan al navegador) ──

# Activa el modo IA del chatbot (requiere desplegar /api/chat con ANTHROPIC_API_KEY).
# Si es "false" o falla la API, el chatbot responde con su motor local.
VITE_AI_ENABLED=false

# Número de WhatsApp en formato internacional, sólo dígitos (ej. 573001234567).
# Vacío = se ocultan los botones de WhatsApp y se usa el correo.
VITE_WHATSAPP_NUMBER=

# Correo de contacto mostrado en el chat y usado en los enlaces mailto:.
VITE_CONTACT_EMAIL=hola@cerebrodigital.io

# ── Servidor (Vercel → Settings → Environment Variables; NUNCA con prefijo VITE_) ──

# Clave de la API de Anthropic para /api/chat.
ANTHROPIC_API_KEY=

# Opcional: webhook al que /api/lead reenvía cada lead (Make, Zapier, n8n, CRM, Slack…).
LEAD_WEBHOOK_URL=
